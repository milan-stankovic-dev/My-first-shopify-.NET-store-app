@page
@model MyPublicShopifyApp.Pages.Products.ListModel

<h2>Products</h2>

@if (Model.Products is null)
{
    <p>Loading products...</p>
}
else if (!Model.Products.Any())
{
    <p>No products found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Title</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Title</td>
                    <td>@product.Status</td>
                </tr>
            }
        </tbody>
    </table>
}